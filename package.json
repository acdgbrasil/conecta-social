{
  "name": "conecta-social",
  "private": true,
  "scripts": {
    "infra:up": "bws run -- docker compose up -d social-care-db",
    "infra:reset-db": "bws run -- docker compose down -v && bws run -- docker compose up -d social-care-db",
    "test:infra": "bws run -- /bin/zsh -lc 'SC_DB_HOST=127.0.0.1 SC_DB_PORT=5433 bun test src/modules/social-care/interface/tests/integration'",
    "test:infra:local": "bun test src/modules/social-care/interface/tests/integration",
    "test:perf": "bun test src/shared/tests/perf/imutable-list.hasDuplicates.perf.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "version:patch": "python3 scripts/version.py patch",
    "version:minor": "python3 scripts/version.py minor",
    "version:major": "python3 scripts/version.py major",
    "version:prerelease": "python3 scripts/version.py prerelease"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "^1.3.5"
  },
  "version": "0.3.0",
  "dependencies": {
    "zod": "^4.3.6"
  }
}
