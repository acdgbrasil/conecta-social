{
	"name": "conecta-social",
	"private": true,
	"scripts": {
		"test": "bun test",
		"test:unit": "python3 scripts/run_unit_tests.py 98",
		"test:smoke": "RUN_NON_UNIT=1 bun test src/shared/tests/smoke",
		"test:hardening": "RUN_NON_UNIT=1 bun test src/tests src/modules/social-care/interface/adapter/http",
		"test:integration": "bun run test:infra",
		"test:integration:local": "bun run test:infra:local",
		"test:non-unit": "RUN_NON_UNIT=1 bun test src/tests src/shared/tests/smoke src/modules/social-care/interface/adapter/http",
		"test:full": "RUN_NON_UNIT=1 RUN_PERF=1 RUN_DB_INTEGRATION=1 bun test",
		"dev": "bws run -- bun --watch src/server.ts",
		"infra:up": "bws run -- docker compose up -d",
		"infra:down": "docker compose down",
		"infra:auth:seed": "docker compose exec logto npm run cli db seed -- --swe",
		"infra:reset-db": "bws run -- docker compose down -v --remove-orphans && bws run -- docker compose up -d",
		"test:infra": "bws run -- sh -c 'RUN_DB_INTEGRATION=1 SC_DB_HOST=127.0.0.1 SC_DB_PORT=5433 bun test src/modules/social-care/interface/tests/integration'",
		"test:infra:local": "RUN_DB_INTEGRATION=1 bun test src/modules/social-care/interface/tests/integration",
		"test:perf": "RUN_PERF=1 bun test src/shared/tests/performance src/shared/tests/perf",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check --write .",
		"version:patch": "python3 scripts/version.py patch",
		"version:minor": "python3 scripts/version.py minor",
		"version:major": "python3 scripts/version.py major",
		"version:prerelease": "python3 scripts/version.py prerelease"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/bun": "^1.3.5"
	},
	"version": "0.3.1",
	"dependencies": {
		"@hono/swagger-ui": "^0.5.3",
		"@hono/zod-openapi": "^1.2.1",
		"hono": "^4.11.9",
		"zod": "^4.3.6"
	}
}
