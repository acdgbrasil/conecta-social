{
  "name": "conecta-social",
  "private": true,
  "scripts": {
    "infra:up": "bws run -- docker compose up -d",
    "test:infra": "bws run -- bun test packages/conecta-raros/social-care/infrastructure/tests/integration/",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "version:patch": "bun run scripts/version.ts patch",
    "version:minor": "bun run scripts/version.ts minor",
    "version:major": "bun run scripts/version.ts major",
    "version:prerelease": "bun run scripts/version.ts prerelease"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "^1.3.5"
  }
}
