# ============================================================
# CONECTA SOCIAL - Configuração de Ambiente
# ============================================================
# ⚠️  SEGURANÇA: NÃO commite este arquivo com valores reais!
# ⚠️  Copie para .env e preencha com valores seguros.
# ============================================================

# --- Servidor ---
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
LOGTO_WEBHOOK_SECRET=test_secret_123

# --- Social Care Database (PostgreSQL Cluster) ---
SC_DB_HOST=localhost
SC_DB_PORT=5433
SC_DB_USER=          # ❗ OBRIGATÓRIO - ex: admin
SC_DB_PASSWORD=      # ❗ OBRIGATÓRIO - senha forte
SC_DB_NAME=          # ❗ OBRIGATÓRIO - ex: social_care

# --- Logto Database (Isolado no Cluster) ---
LOGTO_DB_USER=logto_user
LOGTO_DB_PASSWORD=   # ❗ OBRIGATÓRIO
LOGTO_DB_NAME=logto_db

# --- Logto Auth/IAM ---
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
LOGTO_SECRET_VAULT_KEK=  # ❗ OBRIGATÓRIO - gere com: openssl rand -base64 32

# --- Management API (⚠️ IMPORTANTE PARA SELF-HOSTED) ---
# Em modo Self-hosted, o Resource Indicator é sempre este abaixo:
LOGTO_API_RESOURCE_INDICATOR=https://default.logto.app/api

# ============================================================
# 🔐 GUIA DE SEGURANÇA
# ============================================================
# 1. Gere senhas fortes:
#    openssl rand -base64 24
#
# 2. Gere chave criptográfica Logto:
#    openssl rand -base64 32
#
# 3. NUNCA use valores de exemplo em produção
#
# 4. Adicione .env ao .gitignore (já configurado)
# ============================================================
