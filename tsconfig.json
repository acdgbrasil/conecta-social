{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "typeRoots": ["./types"],
    "paths": {
      "@conecta/shared": ["./src/shared/index.ts"],
      "@conecta/shared/*": ["./src/shared/*"],
      "@conecta/social-care": ["./src/modules/social-care/index.ts"],
      "@conecta/social-care/*": ["./src/modules/social-care/*"],
      "@conecta/result": ["./src/shared/result-pattern/index.ts"],
      "@conecta/result/*": ["./src/shared/result-pattern/*"],
      "@conecta/domain-error": ["./src/shared/erros-pattern/index.ts"],
      "@conecta/domain-error/*": ["./src/shared/erros-pattern/*"],
      "@conecta/fn": ["./src/shared/fn-pattern/index.ts"],
      "@conecta/fn/*": ["./src/shared/fn-pattern/*"],
      "@conecta/uuid": ["./src/shared/uuid-pattern/index.ts"],
      "@conecta/uuid/*": ["./src/shared/uuid-pattern/*"],
      "@conecta/option": ["./src/shared/option-pattern/index.ts"],
      "@conecta/option/*": ["./src/shared/option-pattern/*"],
      "@conecta/ports": ["./src/shared/ports/index.ts"],
      "@conecta/ports/*": ["./src/shared/ports/*"],
      "@conecta/runtime/*": ["./src/infrastructure/runtime/*"],
      "@conecta/adapters": ["./src/shared/adapters/index.ts"],
      "@conecta/adapters/*": ["./src/shared/adapters/*"]
    }
  },
  "include": ["src", "types"]
}
