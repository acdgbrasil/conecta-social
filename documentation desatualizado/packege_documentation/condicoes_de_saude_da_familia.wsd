@startuml

    package "Condições de Saúde da familia" {

           

        class Family {
            -ObjectID id
            -boolean livinInShelter
            -Date createdAt
            -Date updatedAt
            -String fullNameOfReferencePerson
            -String socialName
            -String motherName
            -Number referencePersonNIS
            -String referencePersonCPF
            -RG referencePersonRG
            -String adress
            -String adressNumber
            -String complement
            -String neighborhood
            -String CEP
            -String referenceAdressPoints
            -TYPE_LOCATION locationType
            -ENTRY_TYPE entryType
            -String whoRefered
            -String familyFirstDemand
            -ageGroup ageGroup
            -EducationalConditionsOfFamily educationalConditionsOfFamily
            -SchoolVunerabilityIndex schoolVunerabilityIndex
            -List<BolsaFamiliaSchoolNoncomplianceNote> bolsaFamiliaSchoolNoncomplianceNote
            -work_conditions work_conditions
            -Person_with_disability person_with_disability
            -bool hasBasicsActivitiesOfDailyLiving
            -bool hasFoodInsecurity
            -bool hasSeriusIllness
            -List<person_with_serius_illness> persons_with_serius_illness
            -bool hasMemberWithControllerMedication
            -List<person_with_controller_medication> persons_with_controller_medication
            -hasAlcoholismProblem
            -List<person_with_alcoholism_problem> persons_with_alcoholism_problem
            -hasDrugAddictionProblem
            -List<person_with_drug_addiction_problem> persons_with_drug_addiction_problem
            -List<PregnantPerson> pregnantPersons
            -List<BolsaFamiliaHealthNoncomplianceNote> bolsaFamiliaHealthNoncomplianceNotes
            -map<String,dynamic> familySpecifics
            -map<String,Bool> socialBenefits
            -List<String> referencePhone
            -List<FamilyMember> familyMembers
            -List<String> observations
        }

        object Person_with_disability{
            ObjectId objectId
            Date createdAt
            Date updatedAt
            Number nOrder
            String firstName
            TYPE_OF_DISABILITY typeOfDisability
            bool needForConstantCare
            List<ResponsibleForCare> responsibleForCare
        }

        enum TYPE_OF_DISABILITY{
            blindness
            low_vision
            severe_or_deep_deafness
            mild_or_moderate_deafness
            physical_deficiency
            mental_or_intellectual_disability
            down_syndrome
            mental_disorder
        }

    }

        package "Condições de Saúde da familia extra" {
            object ResponsibleForCare {
                ObjectId objectId
                Date createdAt
                Date updatedAt
                Number nOrder
                String name
                String caregiverBond
                Number nOrderOfCaregiver
            }

            object person_with_serius_illness{
                ObjectId objectId
                Date createdAt
                Date updatedAt
                Number nOrder
                String firstName
                String typeOfSeriusIllness
            }

            object person_with_controller_medication{
                ObjectId objectId
                Date createdAt
                Date updatedAt
                Number nOrder
                String firstName
                String typeOfMedication
            }

            object person_with_alcoholism_problem{
                ObjectId objectId
                Date createdAt
                Date updatedAt
                Number nOrder
                String firstName
            }

            object person_with_drug_addiction_problem{
                ObjectId objectId
                Date createdAt
                Date updatedAt
                Number nOrder
                String firstName
                String typeOfDrug
            }

            object PregnantPerson {
                ObjectId objectId
                Date createdAt
                Date updatedAt
                Number nOrder
                Number gestationalMouth
                bool hasIniciatePreNatal
            }

        }

        

        enum SplitOcorrence {
            first_split = 01
            second_split = 02
        }

        object BolsaFamiliaHealthNoncomplianceNote{
        Date createdAt
        Date updatedAt
        Number nOrder
        SplitOcorrence splitOcorrence
        NoncomplianceEfects noncomplianceEfects
        bool requestsSuspensionOfTheEffect
        }

        enum NoncomplianceEfects{
        Advetisement
        Blocked
        Suspended
        Canceled
    }

    Family <-- Person_with_disability
    Person_with_disability <-- TYPE_OF_DISABILITY 
    Family <-- ResponsibleForCare
    Family <-- person_with_serius_illness
    Family <-- person_with_controller_medication
    Family <-- person_with_alcoholism_problem
    Family <-- person_with_drug_addiction_problem
    BolsaFamiliaHealthNoncomplianceNote <-- SplitOcorrence
    BolsaFamiliaHealthNoncomplianceNote <-- NoncomplianceEfects
    Family <-- BolsaFamiliaHealthNoncomplianceNote
    

@enduml