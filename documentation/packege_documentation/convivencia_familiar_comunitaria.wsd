@startuml

    package "Convivencia Familiar e Comunitária" {

        class Family {
            -ObjectID id
            -boolean livinInShelter
            -Date createdAt
            -Date updatedAt
            -String fullNameOfReferencePerson
            -String socialName
            -String motherName
            -Number referencePersonNIS
            -String referencePersonCPF
            -RG referencePersonRG
            -String adress
            -String adressNumber
            -String complement
            -String neighborhood
            -String CEP
            -String referenceAdressPoints
            -TYPE_LOCATION locationType
            -ENTRY_TYPE entryType
            -String whoRefered
            -String familyFirstDemand
            -ageGroup ageGroup
            -EducationalConditionsOfFamily educationalConditionsOfFamily
            -SchoolVunerabilityIndex schoolVunerabilityIndex
            -List<BolsaFamiliaSchoolNoncomplianceNote> bolsaFamiliaSchoolNoncomplianceNote
            -work_conditions work_conditions
            -Person_with_disability person_with_disability
            -bool hasBasicsActivitiesOfDailyLiving
            -bool hasFoodInsecurity
            -bool hasSeriusIllness
            -List<Benefits_access> benefits_access
            -List<person_with_serius_illness> persons_with_serius_illness
            -bool hasMemberWithControllerMedication
            -List<person_with_controller_medication> persons_with_controller_medication
            -hasAlcoholismProblem
            -List<person_with_alcoholism_problem> persons_with_alcoholism_problem
            -hasDrugAddictionProblem
            -List<person_with_drug_addiction_problem> persons_with_drug_addiction_problem
            -List<PregnantPerson> pregnantPersons
            -List<BolsaFamiliaHealthNoncomplianceNote> bolsaFamiliaHealthNoncomplianceNotes
            -FamilyAndCommunityCoexistence familyAndCommunityCoexistence
            -map<String,dynamic> familySpecifics
            -map<String,Bool> socialBenefits
            -List<String> referencePhone
            -List<FamilyMember> familyMembers
            -List<String> observations
        }

       object FamilyAndCommunityCoexistence{
        TimeThatTheFamilyInTheState tymeInTheState
        TimeThatTheFamilyInTheMunicipality tymeInTheMunicipality
        TimeThatTheFamilyInNeighborhood tymeInTheNeighborhood
        bool hasDiscriminatedAgainstByAFamilyMember
        bool hasSupportNetworkWhereYouLive neighbor
        bool hasNeighborSupportNetworkWhereYouLive
        bool DoesTheFamilyParticipateInACommunityOrReligiousSupportNetwork
        bool anyMemberIsPoliticallyOrganized
        Number hasChildWithoutLeisureAccess
        Number hasSeniorWithoutLeisureAccess
        Number hasDependentsWithoutAdultCompanionship
        List<AvaliationOfConjugalRelationship> avaliationOfConjugalRelationships
        List<AvaliationOfConjugalRelationship> avaliationOfParentsAndChildrensRelationships
        List<AvaliationOfConjugalRelationship> avaliationOfBrothesRelationships
        List<AvaliationOfConjugalRelationship> avaliationOfOtherRelationships
        List<String> observations
        
       }

       object TimeThatTheFamilyInTheState{
        Number tymeAreLivin
        Char awaysLivingHere
       }

       object TimeThatTheFamilyInTheMunicipality{
        Number tymeAreLivin
        Char awaysLivingHere
       }

       object TimeThatTheFamilyInNeighborhood{
        Number tymeAreLivin
        Char awaysLivingHere
       }

       object AvaliationRelationship{
        Date createAt
        bool isConflituosWithViolence
        bool isConflituosWithoutViolence
        bool dontHasConflit
        String nameOfResponsiblew
       }

        Family <-- FamilyAndCommunityCoexistence
        FamilyAndCommunityCoexistence <-- TimeThatTheFamilyInTheState
        FamilyAndCommunityCoexistence <-- TimeThatTheFamilyInTheMunicipality
        FamilyAndCommunityCoexistence <-- TimeThatTheFamilyInNeighborhood
        FamilyAndCommunityCoexistence <-- AvaliationRelationship
    }



@enduml