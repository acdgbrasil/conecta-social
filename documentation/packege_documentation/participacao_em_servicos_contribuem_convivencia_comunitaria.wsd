@startuml

    package "participação em serviços, programas ou projetos para desenvolvimento de competências comunitarias e para fortalecimento e vinculos" {
        
         class Family {
            -ObjectID id
            -boolean livinInShelter
            -Date createdAt
            -Date updatedAt
            -String fullNameOfReferencePerson
            -String socialName
            -String motherName
            -Number referencePersonNIS
            -String referencePersonCPF
            -RG referencePersonRG
            -String adress
            -String adressNumber
            -String complement
            -String neighborhood
            -String CEP
            -String referenceAdressPoints
            -TYPE_LOCATION locationType
            -ENTRY_TYPE entryType
            -String whoRefered
            -String familyFirstDemand
            -ageGroup ageGroup
            -EducationalConditionsOfFamily educationalConditionsOfFamily
            -SchoolVunerabilityIndex schoolVunerabilityIndex
            -List<BolsaFamiliaSchoolNoncomplianceNote> bolsaFamiliaSchoolNoncomplianceNote
            -work_conditions work_conditions
            -Person_with_disability person_with_disability
            -bool hasBasicsActivitiesOfDailyLiving
            -bool hasFoodInsecurity
            -bool hasSeriusIllness
            -List<Benefits_access> benefits_access
            -List<person_with_serius_illness> persons_with_serius_illness
            -bool hasMemberWithControllerMedication
            -List<person_with_controller_medication> persons_with_controller_medication
            -hasAlcoholismProblem
            -List<person_with_alcoholism_problem> persons_with_alcoholism_problem
            -hasDrugAddictionProblem
            -List<person_with_drug_addiction_problem> persons_with_drug_addiction_problem
            -List<PregnantPerson> pregnantPersons
            -List<BolsaFamiliaHealthNoncomplianceNote> bolsaFamiliaHealthNoncomplianceNotes
            -FamilyAndCommunityCoexistence familyAndCommunityCoexistence
            -List<PARTICIPATION_SERVICE_PROGRAM_PROJECT> participationServiceProgramProjects
            -map<String,dynamic> familySpecifics
            -map<String,Bool> socialBenefits
            -List<String> referencePhone
            -List<FamilyMember> familyMembers
            -List<String> observations
        }

        object PARTICIPATION_SERVICE_PROGRAM_PROJECT {
            Number nOrder 
            String firstName
            CODE_REALIZATION_SERVICE_PROGRAM_OR_PROJECT codeRealizationServiceProgramOrProject
            UNITY_TYPE_REALIZATION_SERVICE_PROGRAM_OR_PROJECT unityTypeRealizationServiceProgramOrProject
            Date dateStart
            Date dateEnd
            List<String> observations
        }
        
        enum UNITY_TYPE_REALIZATION_SERVICE_PROGRAM_OR_PROJECT {
            own_unity = 1
            other_public_unity = 2
            other_private_unity = 3
            educational_institution = 4
            other = 9
        }

        enum CODE_REALIZATION_SERVICE_PROGRAM_OR_PROJECT {
            comunity_service_for_teenagers_childrens = 1
            comunity_service_for_elderly = 2
            comunity_specific_fortification_PAIF = 3
            specific_fortification_PAIF = 4
            program_service_specific_not_contiued = 5
            program_project_other_sectoral_policies = 6
            other = 99
        }

        Family <-- PARTICIPATION_SERVICE_PROGRAM_PROJECT
        PARTICIPATION_SERVICE_PROGRAM_PROJECT <-- UNITY_TYPE_REALIZATION_SERVICE_PROGRAM_OR_PROJECT
        PARTICIPATION_SERVICE_PROGRAM_PROJECT <-- CODE_REALIZATION_SERVICE_PROGRAM_OR_PROJECT
    }

@enduml