meta {
  name: Deactivate User
  type: http
  seq: 2
}

patch {
  url: {{baseURL}}/adm/deactivate/user
  body: json
  auth: none
}

body:json {
  {
    "admEmail": "{{superAdminEmail}}",
    "email": "user_to_deactivate@example.com"
  }
}

tests {
  const Ajv = require('ajv');
  const ajv = new Ajv();
  const schema = {
    type: 'object',
    properties: {
      message: { type: 'string' }
    },
    required: ['message']
  };

  const validate = ajv.compile(schema);
  const body = res.getBody();
  if(typeof body === 'string') {
    try {
      const parsedBody = JSON.parse(body);
      const valid = validate(parsedBody);
      if (!valid) {
        console.log(validate.errors);
      }
      expect(valid).to.be.true;
    } catch (e) {
      console.log('Failed to parse response body as JSON');
      expect.fail('Response body is not valid JSON');
    }
  } else {
    const valid = validate(body);
    if (!valid) {
      console.log(validate.errors);
    }
    expect(valid).to.be.true;
  }
  expect(res.getStatus()).to.equal(200);
  expect(res.getBody().message).to.be.oneOf(["User has been successfully deactivated!", "Failed to deactivate user!"]);
}
