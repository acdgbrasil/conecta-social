meta {
  name: Create ADM User
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/create/adm
  body: json
  auth: none
}

body:json {
  {
    "email": "new_adm_{{$timestamp}}@example.com",
    "fullName": "New ADM",
    "admEmail": "{{superAdminEmail}}"
  }
}

tests {
  expect(res.getStatus()).to.equal(201);
}
