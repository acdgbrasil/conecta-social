meta {
  name: Create Common User
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/create/user
  body: json
  auth: none
}

body:json {
  {
    "admEmail": "{{superAdminEmail}}",
    "email": "new_user_{{$timestamp}}@example.com",
    "fullName": "New User",
    "crm": "123456"
  }
}

tests {
  expect(res.getStatus()).to.equal(201);
}
