meta {
  name: Reset Password
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/auth/reset/password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "code": "MANUAL_CODE_FROM_EMAIL",
    "newPassword": "new_password_123",
    "emailToken": "{{emailToken}}"
  }
}

tests {
  // This test requires a valid code sent to the user's email.
  // The emailToken is captured from the 'Forgot Password' request.
  // It's not fully automated.
  expect(res.getStatus()).to.be.oneOf([200, 400]);
}
