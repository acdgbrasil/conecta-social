{
  "name": "@conecta/legacy",
  "version": "1.0.0",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "lint": "bun x eslint .",
    "lint:fix": "bun x eslint . --fix",
    "typecheck": "bun x tsc --pretty --project tsconfig.json",
    "typecheck:new": "bun x tsc --pretty --project tsconfig.new.json",
    "ci": "bun run typecheck && bun run lint --max-warnings=0",
    "test": "bun test",
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "validate": "bun run ci"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.8.8",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^2.0.16",
    "bun-types": "^1.2.22",
    "eslint": "^8.57.1",
    "eslint-plugin-boundaries": "^4.2.0",
    "eslint-plugin-functional": "^6.0.0",
    "eslint-plugin-import-x": "^0.3.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-security": "^3.0.0",
    "eslint-plugin-sonarjs": "^1.0.3",
    "eslint-plugin-unicorn": "^52.0.0",
    "supertest": "^6.3.4",
    "typescript": "^5.2.2",
    "typescript-eslint": "^7.18.0"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.3",
    "@types/express": "^4.17.21",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.4",
    "pg": "^8.16.2",
    "resend": "^4.6.0"
  }
}
