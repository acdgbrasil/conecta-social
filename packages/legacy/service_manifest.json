
{
  "service": "conecta-raros-api",
  "version": "v1",
  "runtime": {
    "language": "typescript",
    "framework": "express",
    "container": false
  },
  "envs": ["dev", "prod"],
  "endpoints": [
    {
      "path": "/api/auth/register",
      "method": "POST",
      "purpose": "Registrar um novo usuário no sistema.",
      "inputs": {
        "name": "string",
        "email": "string",
        "pass": "string"
      },
      "outputs": {
        "message": "string",
        "token": "string"
      },
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "none"
      }
    },
    {
      "path": "/api/auth/login",
      "method": "POST",
      "purpose": "Autenticar um usuário e retornar um token JWT.",
      "inputs": {
        "email": "string",
        "pass": "string"
      },
      "outputs": {
        "token": "string"
      },
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "none"
      }
    },
    {
      "path": "/api/auth/forgot/password",
      "method": "POST",
      "purpose": "Iniciar o processo de redefinição de senha, enviando um código para o e-mail do usuário.",
      "inputs": {
        "email": "string"
      },
      "outputs": {
        "message": "string",
        "emailToken": "string"
      },
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "none"
      }
    },
    {
      "path": "/api/auth/reset/password",
      "method": "POST",
      "purpose": "Redefinir a senha do usuário usando o código de verificação.",
      "inputs": {
        "email": "string",
        "code": "string",
        "newPassword": "string",
        "emailToken": "string"
      },
      "outputs": {
        "message": "string"
      },
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "none"
      }
    },
    {
      "path": "/api/adm/list/all/:admEmail",
      "method": "GET",
      "purpose": "Listar todos os usuários (requer permissão de super administrador).",
      "inputs": {
        "params": {
          "admEmail": "string"
        }
      },
      "outputs": {
        "response": "Array<User>"
      },
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "jwt",
        "role": "super-admin"
      }
    },
    {
      "path": "/api/adm/deactivate/user",
      "method": "PATCH",
      "purpose": "Desativar a conta de um usuário (requer permissão de super administrador).",
      "inputs": {
        "admEmail": "string",
        "email": "string"
      },
      "outputs": {
        "message": "string"
      },
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "jwt",
        "role": "super-admin"
      }
    },
    {
      "path": "/create/reference/person",
      "method": "POST",
      "purpose": "Criar uma nova pessoa de referência com dados detalhados.",
      "inputs": "object",
      "outputs": "object",
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "jwt"
      }
    },
    {
      "path": "/create/family/person",
      "method": "POST",
      "purpose": "Adicionar um novo membro à composição familiar.",
      "inputs": "object",
      "outputs": "object",
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "jwt"
      }
    },
    {
      "path": "/create/home/conditions",
      "method": "POST",
      "purpose": "Registrar as condições de moradia de uma família.",
      "inputs": "object",
      "outputs": "object",
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "jwt"
      }
    },
    {
      "path": "/create/work/condition",
      "method": "POST",
      "purpose": "Registrar as condições de trabalho e renda de uma pessoa/família.",
      "inputs": "object",
      "outputs": "object",
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "jwt"
      }
    },
    {
      "path": "/create/violence/situation",
      "method": "POST",
      "purpose": "Registrar situações de violação de direitos e violência.",
      "inputs": "object",
      "outputs": "object",
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "jwt"
      }
    },
    {
      "path": "/create/health/condition",
      "method": "POST",
      "purpose": "Registrar as condições de saúde de uma pessoa/família.",
      "inputs": "object",
      "outputs": "object",
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "jwt"
      }
    },
    {
      "path": "/list/reference/person/:familyCompositionId",
      "method": "GET",
      "purpose": "Listar as pessoas de referência de uma composição familiar.",
      "inputs": {
        "params": {
          "familyCompositionId": "string"
        }
      },
      "outputs": "Array<ReferencePerson>",
      "errors": ["ProblemDetails"],
      "auth": {
        "type": "jwt"
      }
    }
  ],
  "models": [
    {
      "name": "User",
      "storage": "postgres",
      "description": "Representa um usuário do sistema (administrador ou usuário comum).",
      "indexes": ["email"]
    },
    {
      "name": "ReferencePerson",
      "storage": "postgres",
      "description": "Representa a pessoa de referência para uma família, contendo dados pessoais e de contato.",
      "indexes": ["cpf", "nis"]
    },
    {
      "name": "FamilyComposition",
      "storage": "postgres",
      "description": "Modela a estrutura familiar, incluindo todos os seus membros e suas relações.",
      "indexes": ["reference_person_id"]
    },
    {
      "name": "AuthData",
      "storage": "mongodb",
      "description": "Armazena dados temporários para processos de autenticação, como tokens de redefinição de senha.",
      "indexes": ["email", "createdAt"]
    }
  ],
  "integrations": [
    {
      "name": "sendgrid",
      "purpose": "Envio de e-mails transacionais (ex: redefinição de senha).",
      "secrets": ["SENDGRID_API_KEY"]
    },
    {
      "name": "resend",
      "purpose": "Alternativa para envio de e-mails transacionais.",
      "secrets": ["RESEND_API_KEY"]
    },
    {
      "name": "jsonwebtoken",
      "purpose": "Geração e validação de tokens JWT para autenticação e autorização."
    },
    {
      "name": "bcryptjs",
      "purpose": "Hashing de senhas para armazenamento seguro."
    }
  ],
  "schedules": [],
  "security": {
    "headers": ["CORS"],
    "rateLimit": false,
    "owaspChecks": []
  },
  "observability": {
    "logging": "console",
    "events": [],
    "otlp": false
  },
  "schemas": {
    "User": {
      "id": "number",
      "fullName": "string",
      "email": "string",
      "passwordHash": "string",
      "crm": "string | null",
      "role": "string",
      "createdAt": "Date",
      "updatedAt": "Date",
      "isActive": "boolean"
    },
    "ReferencePerson": {
      "...": "Estrutura complexa com dados pessoais, endereço, documentos, etc."
    },
    "ProblemDetails": {
      "type": "string",
      "title": "string",
      "status": "integer",
      "detail": "string",
      "instance": "string"
    }
  }
}
